---
import GlobalToolSearch from "@/components/GlobalToolSearch";
import FavoriteButton from "@/components/FavoriteButton";
import ToolHelp from "@/components/tool/ToolHelp.astro";
import Base from "@/layouts/Base.astro";
import { ClientRouter } from "astro:transitions";
import type { ToolAccent } from "@/tools/registry";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  accent?: ToolAccent;
  help?: readonly string[];
  toolId?: string;
}

const { title, description, ogImage, accent, help, toolId } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <a class="ts-skip-link" href="#main-content">Skip to content</a>

  <div class="ts-page" data-tool-id={toolId} {...(accent ? { "data-tool-accent": accent } : {})}>
    <main id="main-content" class="ts-main" tabindex="-1">
      <header class="ts-tool-heading">
        <a href="/" class="ts-back-link" title="All tools">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 5-7 7 7 7" />
          </svg>
          <span class="sr-only">All tools</span>
        </a>
        <h1 id="tool-title">{title}</h1>
        <div class="ts-tool-actions">
          {toolId ? <FavoriteButton toolId={toolId} toolName={title} class="tool-header-favorite" client:load /> : null}
          <GlobalToolSearch client:load />
          {description ? <ToolHelp title={title} description={description} notes={help} /> : null}
        </div>
      </header>
      <slot />
    </main>
  </div>
</Base>

<script>
  import { navigate } from "astro:transitions/client";
  import { setToolHandoffNavigator, toolHandoffs } from "@/lib/toolHandoff";

  setToolHandoffNavigator(async (route) => {
    await navigate(route);
    if (location.pathname.replace(/\/$/, "") !== route) {
      throw new Error("Navigation did not reach the selected tool.");
    }
  });
  document.addEventListener("astro:after-swap", () => {
    toolHandoffs.discardUnless(
      document.querySelector<HTMLElement>("[data-tool-id]")?.dataset.toolId
    );
  });
  window.addEventListener("pagehide", () => toolHandoffs.clear());
</script>

<style>
  .ts-page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    --tool-padding: 1rem;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  .ts-main {
    flex: 1;
    min-width: 0;
    padding-top: clamp(1rem, 2vh, 1.5rem);
    padding-bottom: 2.5rem;
  }

  /* The programmatic focus target receives focus on client-router swaps; its
     global :focus-visible ring reads as a stray page border, so suppress the
     outline while keeping focus and tabindex for a11y. */
  #main-content:focus-visible {
    outline: none;
  }

  .ts-tool-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: min(100%, var(--tool-width));
    margin: 0 auto;
    padding: 0 var(--tool-padding) 1rem;
    border-bottom: 1px solid var(--border);
  }

  .ts-back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1;
    transition: color var(--motion-fast) var(--motion-ease-standard);
  }

  @media (hover: hover) {
    .ts-back-link:hover {
      color: var(--text-primary);
    }
  }

  .ts-tool-heading h1 {
    margin: 0;
    min-width: 0;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ts-tool-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .ts-page { --tool-padding: 1.5rem; }
  }

  @media (max-width: 640px) {
    .ts-tool-heading {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .ts-back-link { justify-self: start; }
    .ts-tool-actions { grid-column: 2; grid-row: 1; }
    .ts-tool-heading h1 { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
