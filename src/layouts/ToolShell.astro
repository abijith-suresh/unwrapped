---
import Base from "@/layouts/Base.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const FOOTER_LINKS = [
  { href: "/about", label: "About" },
  { href: "/features", label: "Features" },
  { href: "/privacy", label: "Privacy" },
  {
    href: "https://github.com/abijith-suresh/unwrapped",
    label: "GitHub",
    external: true,
  },
];
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <a class="ts-skip-link" href="#main-content">Skip to content</a>

  <div class="ts-page">
    <header class="ts-header">
      <a href="/" class="ts-brand" translate="no">
        unwrapped<span class="ts-brand-tld">.tools</span>
      </a>
    </header>

    <main id="main-content" class="ts-main" tabindex="-1">
      <section class="ts-tool-heading" aria-labelledby="tool-title">
        <h1 id="tool-title">{title}</h1>
        {description ? <p class="ts-tool-description">{description}</p> : null}
      </section>
      <slot />
    </main>
    <footer class="ts-footer">
      <nav aria-label="Site navigation" class="ts-footer-nav">
        {
          FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              class="ts-footer-link"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</Base>

<style>
  .ts-page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-inline: clamp(1.25rem, 6vw, 7rem);
  }

  .ts-header {
    width: min(100%, 1120px);
    margin-inline: auto;
    gap: 0.5rem;
    padding: 1rem 0;
  }

  .ts-main {
    flex: 1;
    min-width: 0;
    padding-top: clamp(2rem, 5vh, 3.5rem);
  }

  .ts-tool-heading {
    width: min(100%, 1120px);
    margin: 0 auto;
    padding: 0 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .ts-tool-heading h1 {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    text-wrap: balance;
  }

  .ts-tool-description {
    max-width: 58rem;
    margin: 0.8rem 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .ts-footer {
    padding: 2rem 0 2.5rem;
  }

  .ts-footer-nav {
    justify-content: center;
  }

  @media (max-width: 600px) {
    .ts-header {
      min-height: 3.75rem;
      padding-block: 0.8rem;
    }

    .ts-tool-heading {
      padding-bottom: 1.25rem;
    }
  }
</style>
