---
import Base from "@/layouts/Base.astro";
import { ClientRouter } from "astro:transitions";
import type { ToolAccent } from "@/tools/registry";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  accent?: ToolAccent;
}

const { title, description, ogImage, accent } = Astro.props;

const FOOTER_LINKS = [
  { href: "/about", label: "About" },
  { href: "/features", label: "Features" },
  { href: "/privacy", label: "Privacy" },
  {
    href: "https://github.com/abijith-suresh/unwrapped",
    label: "GitHub",
    external: true,
  },
];
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <a class="ts-skip-link" href="#main-content">Skip to content</a>

  <div class="ts-page" {...(accent ? { "data-tool-accent": accent } : {})}>
    <main id="main-content" class="ts-main" tabindex="-1">
      <header class="ts-tool-heading">
        <div class="ts-tool-identity">
          <a href="/" class="ts-back-link" aria-label="All tools">
            <span aria-hidden="true">←</span><span class="ts-back-label">All tools</span>
          </a>
          <span class="ts-tool-separator" aria-hidden="true">/</span>
          <h1 id="tool-title">{title}</h1>
        </div>
        {
          description ? (
            <details class="ts-tool-help">
              <summary>Help <span aria-hidden="true">⌄</span></summary>
              <p class="ts-tool-description">{description}</p>
            </details>
          ) : null
        }
      </header>
      <slot />
    </main>
    <footer class="ts-footer">
      <nav aria-label="Site navigation" class="ts-footer-nav">
        {
          FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              class="ts-footer-link"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</Base>

<style>
  .ts-page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-inline: clamp(1.25rem, 6vw, 7rem);
  }

  .ts-main {
    flex: 1;
    min-width: 0;
    padding-top: clamp(1rem, 2vh, 1.5rem);
  }

  .ts-tool-heading {
    position: relative;
    width: min(100%, 1120px);
    margin: 0 auto;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .ts-tool-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-right: 5rem;
  }

  .ts-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    min-height: 2.75rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .ts-back-link:hover {
    color: var(--text-primary);
  }

  .ts-tool-separator {
    color: var(--text-secondary);
  }

  .ts-tool-heading h1 {
    margin: 0;
    min-width: 0;
    color: var(--text-primary);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ts-tool-help summary {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    list-style: none;
    cursor: pointer;
  }

  .ts-tool-help summary::-webkit-details-marker {
    display: none;
  }

  .ts-tool-help summary:hover {
    color: var(--text-primary);
  }

  .ts-tool-help[open] summary span {
    transform: rotate(180deg);
  }

  .ts-back-link:focus-visible,
  .ts-tool-help summary:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
    border-radius: 0.2rem;
  }

  .ts-tool-description {
    margin: 0.5rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .ts-footer {
    padding: 2rem 0 2.5rem;
  }

  .ts-footer-nav {
    justify-content: center;
  }

  @media (max-width: 480px) {
    .ts-tool-identity {
      gap: 0.5rem;
      padding-right: 4.5rem;
    }

    .ts-back-link {
      justify-content: center;
      min-width: 2.75rem;
    }

    .ts-back-label,
    .ts-tool-separator {
      display: none;
    }
  }
</style>
