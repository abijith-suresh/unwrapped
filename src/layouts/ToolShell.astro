---
import GlobalToolSearch from "@/components/GlobalToolSearch";
import FavoriteButton from "@/components/FavoriteButton";
import ToolHelp from "@/components/tool/ToolHelp.astro";
import Base from "@/layouts/Base.astro";
import { ClientRouter } from "astro:transitions";
import type { ToolAccent } from "@/tools/registry";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  accent?: ToolAccent;
  help?: readonly string[];
  toolId?: string;
}

const { title, description, ogImage, accent, help, toolId } = Astro.props;

const FOOTER_LINKS = [
  { href: "/about", label: "About" },
  { href: "/features", label: "Features" },
  { href: "/privacy", label: "Privacy" },
  {
    href: "https://github.com/abijith-suresh/unwrapped",
    label: "GitHub",
    external: true,
  },
];
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <a class="ts-skip-link" href="#main-content">Skip to content</a>

  <div class="ts-page" data-tool-id={toolId} {...(accent ? { "data-tool-accent": accent } : {})}>
    <main id="main-content" class="ts-main" tabindex="-1">
      <header class="ts-tool-heading">
        <a href="/" class="ts-back-link" aria-label="All tools">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="m12 5-7 7 7 7M5 12h14" />
          </svg>
          <span>Tools</span>
        </a>
        <h1 id="tool-title">{title}</h1>
        <div class="ts-tool-actions">
          {toolId ? <FavoriteButton toolId={toolId} toolName={title} class="tool-header-favorite" client:load /> : null}
          <GlobalToolSearch client:load />
          {description ? <ToolHelp title={title} description={description} notes={help} /> : null}
        </div>
      </header>
      <slot />
    </main>
    <footer class="ts-footer">
      <nav aria-label="Site navigation" class="ts-footer-nav">
        {
          FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              class="ts-footer-link"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</Base>

<script>
  import { navigate } from "astro:transitions/client";
  import { setToolHandoffNavigator, toolHandoffs } from "@/lib/toolHandoff";

  setToolHandoffNavigator(async (route) => {
    await navigate(route);
    if (location.pathname.replace(/\/$/, "") !== route) {
      throw new Error("Navigation did not reach the selected tool.");
    }
  });
  document.addEventListener("astro:after-swap", () => {
    toolHandoffs.discardUnless(
      document.querySelector<HTMLElement>("[data-tool-id]")?.dataset.toolId
    );
  });
  window.addEventListener("pagehide", () => toolHandoffs.clear());
</script>

<style>
  .ts-page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    --tool-padding: 1rem;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  .ts-main {
    flex: 1;
    min-width: 0;
    padding-top: clamp(1rem, 2vh, 1.5rem);
  }

  .ts-tool-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: min(100%, var(--tool-width));
    margin: 0 auto;
    padding: 0 var(--tool-padding) 1rem;
    border-bottom: 1px solid var(--border);
  }

  .ts-back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .ts-back-link:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .ts-tool-heading h1 {
    margin: 0;
    min-width: 0;
    padding-left: 0.8rem;
    border-left: 2px solid var(--accent-primary);
    color: var(--accent-primary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ts-tool-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ts-back-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .ts-footer {
    width: min(100%, var(--tool-width));
    margin-inline: auto;
    padding: 2rem var(--tool-padding) 2.5rem;
  }

  .ts-footer-nav {
    justify-content: center;
  }

  @media (min-width: 640px) {
    .ts-page { --tool-padding: 1.5rem; }
  }

  @media (max-width: 640px) {
    .ts-tool-heading {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .ts-back-link { justify-self: start; }
    .ts-tool-actions { grid-column: 2; grid-row: 1; }
    .ts-tool-heading h1 { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
