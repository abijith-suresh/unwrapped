---
import LandingShell from "@/layouts/LandingShell.astro";
import ToolSearch from "@/components/ToolSearch";
---

<LandingShell title="unwrapped.tools">
  <div class="lp-home">
    <section class="lp-home-heading" aria-labelledby="tool-search-title">
      <h1 id="tool-search-title">
        Search tools<span class="lp-home-heading-mark" aria-hidden="true">.</span>
      </h1>
    </section>

    <section class="lp-home-search" id="tool-search" aria-labelledby="tool-search-title">
      <ToolSearch client:load />
    </section>
  </div>
</LandingShell>

<!-- ToolSearch is a SolidJS island, so these styles must stay global. -->
<style is:global>
  .lp-home {
    --lp-home-surface: var(--bg-secondary);
    --lp-home-surface-hover: var(--bg-tertiary);
    --lp-home-border: var(--border);
    --lp-home-text: var(--text-primary);
    --lp-home-secondary: var(--text-secondary);
    --lp-home-muted: var(--text-muted);
    --lp-home-accent: var(--accent-primary);
    --lp-home-accent-secondary: var(--accent-secondary);
    --lp-home-accent-soft: color-mix(in srgb, var(--accent-primary) 24%, var(--bg-secondary));
    --lp-home-border-strong: color-mix(in srgb, var(--border) 70%, var(--text-muted));
    width: 100%;
    padding-bottom: clamp(4rem, 9vh, 6.5rem);
    color: var(--lp-home-text);
  }

  .lp-home-heading {
    padding: clamp(1.5rem, 4vh, 3rem) 0 clamp(1.75rem, 4vh, 2.75rem);
    border-bottom: 1px solid var(--lp-home-border);
  }

  .lp-home-heading h1 {
    margin: 0;
    color: var(--lp-home-text);
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.085em;
    line-height: 0.98;
  }

  .lp-home-heading-mark {
    color: var(--lp-home-accent);
  }

  .lp-home-search {
    padding-top: clamp(1.25rem, 3vh, 2rem);
  }

  .lp-home-search .lp {
    width: 100%;
  }

  .lp-home-search .lp-search {
    position: sticky;
    z-index: 5;
    top: 0.75rem;
    display: flex;
    width: 100%;
    min-height: 4.25rem;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--lp-home-border);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--lp-home-surface) 94%, transparent);
    box-shadow: 0 0.8rem 2.2rem rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(14px);
    transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }

  .lp-home-search .lp-search:focus-within,
  .lp-home-search .lp-search--focused {
    border-color: var(--lp-home-accent);
    background: var(--lp-home-surface-hover);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--lp-home-accent) 12%, transparent),
      0 0.8rem 2.2rem rgba(0, 0, 0, 0.24);
  }

  .lp-home-search .lp-search-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--lp-home-muted);
  }

  .lp-home-search .lp-search-input {
    min-width: 0;
    flex: 1;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--lp-home-text);
    font: 0.98rem var(--font-sans);
  }

  .lp-home-search .lp-search-input::placeholder {
    color: var(--lp-home-muted);
  }

  .lp-home-search .lp-search-clear {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    border-radius: 0.3rem;
    background: transparent;
    color: var(--lp-home-muted);
    cursor: pointer;
    font: 1.2rem/1 var(--font-sans);
  }

  @media (hover: hover) {
    .lp-home-search .lp-search-clear:hover {
      color: var(--lp-home-text);
    }
  }

  .lp-home-search .lp-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .lp-home-search .lp-results > li {
    display: flex;
    min-width: 0;
  }

  .lp-home-search .lp-row {
    position: relative;
    overflow: hidden;
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 10.75rem;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: 1.15rem 1.15rem 1.2rem;
    border: 1px solid var(--lp-home-border);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--lp-home-surface) 68%, var(--bg-primary));
    color: var(--lp-home-text);
    text-decoration: none;
    transition:
      border-color var(--motion-fast) var(--motion-ease-standard),
      background-color var(--motion-fast) var(--motion-ease-standard);
  }

  .lp-home-search .lp-row::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent-primary);
    content: "";
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--motion-base) var(--motion-ease-standard);
  }

  .lp-home-search .lp-row--active {
    border-color: var(--lp-home-border-strong);
    background: color-mix(in srgb, var(--lp-home-surface-hover) 76%, var(--bg-primary));
  }

  .lp-home-search .lp-row--active::before,
  .lp-home-search .lp-row:focus-visible::before {
    transform: scaleY(1);
  }

  @media (hover: hover) {
    .lp-home-search .lp-row:hover {
      border-color: var(--lp-home-border-strong);
      background: color-mix(in srgb, var(--lp-home-surface-hover) 76%, var(--bg-primary));
    }

    .lp-home-search .lp-row:hover::before {
      transform: scaleY(1);
    }
  }

  .lp-home-search .lp-row:focus-visible {
    border-color: var(--accent-primary);
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .lp-home-search .lp-row-icon {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--lp-home-border);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--accent-primary) 12%, var(--bg-secondary));
    color: var(--accent-primary);
    transition:
      border-color var(--motion-fast) var(--motion-ease-standard),
      color var(--motion-fast) var(--motion-ease-standard),
      background-color var(--motion-fast) var(--motion-ease-standard);
  }

  .lp-home-search .lp-row-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .lp-home-search .lp-row--active .lp-row-icon {
    border-color: var(--accent-primary);
    background: color-mix(in srgb, var(--accent-primary) 20%, var(--bg-secondary));
    color: var(--accent-secondary);
  }

  @media (hover: hover) {
    .lp-home-search .lp-row:hover .lp-row-icon {
      border-color: var(--accent-primary);
      background: color-mix(in srgb, var(--accent-primary) 20%, var(--bg-secondary));
      color: var(--accent-secondary);
    }
  }

  .lp-home-search .lp-row-name {
    display: block;
    margin-top: 0.15rem;
    color: var(--lp-home-text);
    font-size: var(--fs-body);
    font-weight: 600;
    transition: color var(--motion-fast) var(--motion-ease-standard);
  }

  .lp-home-search .lp-row--active .lp-row-name {
    color: var(--accent-secondary);
  }

  @media (hover: hover) {
    .lp-home-search .lp-row:hover .lp-row-name {
      color: var(--accent-secondary);
    }
  }

  .lp-home-search .lp-row-desc {
    display: -webkit-box;
    overflow: hidden;
    min-block-size: 2.96em;
    margin-top: auto;
    color: var(--text-secondary);
    font-size: 0.79rem;
    line-height: 1.48;
    padding-right: 2rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .lp-home-search .lp-row-arrow {
    position: absolute;
    right: 1.15rem;
    bottom: 1.05rem;
    color: var(--accent-primary);
    font: 0.95rem/1 var(--font-mono);
    opacity: 0;
    transform: translate(-0.35rem, 0.35rem);
    transition: opacity var(--motion-fast) var(--motion-ease-standard), transform var(--motion-fast) var(--motion-ease-standard);
  }

  .lp-home-search .lp-row--active .lp-row-arrow,
  .lp-home-search .lp-row:focus-visible .lp-row-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (hover: hover) {
    .lp-home-search .lp-row:hover .lp-row-arrow {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  .lp-home-search .lp-row-cat {
    order: 3;
    color: var(--text-muted);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: lowercase;
    transition: color var(--motion-fast) var(--motion-ease-standard);
  }

  .lp-home-search .lp-row--active .lp-row-cat {
    color: var(--accent-primary);
  }

  @media (hover: hover) {
    .lp-home-search .lp-row:hover .lp-row-cat {
      color: var(--accent-primary);
    }
  }

  .lp-home-search .lp-empty {
    margin: 1rem 0;
    color: var(--lp-home-secondary);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .lp-home-search .lp-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .lp-home-search .lp-search {
      top: 0.5rem;
      min-height: 3.75rem;
      padding-inline: 1rem;
    }

    .lp-home-search .lp-results {
      grid-template-columns: 1fr;
    }

    .lp-home-search .lp-row {
      min-height: 9.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-home-search .lp-search,
    .lp-home-search .lp-row,
    .lp-home-search .lp-row::before,
    .lp-home-search .lp-row-icon,
    .lp-home-search .lp-row-name,
    .lp-home-search .lp-row-cat,
    .lp-home-search .lp-row-arrow {
      transition: none;
    }
  }
</style>
