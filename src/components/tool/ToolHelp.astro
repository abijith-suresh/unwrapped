---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<button type="button" class="tool-help-trigger" popovertarget="tool-help" aria-label="About this tool" title="About this tool">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7h.01" />
  </svg>
</button>
<aside id="tool-help" popover="auto" data-tool-help aria-labelledby="tool-help-title">
  <header>
    <h2 id="tool-help-title">About {title}</h2>
    <button type="button" popovertarget="tool-help" popovertargetaction="hide" aria-label="Close help">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </header>
  <p>{description}</p>
</aside>

<script>
  function positionHelp(popover: HTMLElement) {
    const trigger = document.querySelector<HTMLButtonElement>('[popovertarget="tool-help"]');
    if (!trigger) return;
    const rect = trigger.getBoundingClientRect();
    const width = Math.min(360, document.documentElement.clientWidth - 32);
    const top = rect.bottom + 8;
    popover.style.width = `${width}px`;
    popover.style.left = `${Math.max(16, Math.min(rect.right - width, document.documentElement.clientWidth - width - 16))}px`;
    popover.style.top = `${top}px`;
    popover.style.maxHeight = `${Math.max(80, window.innerHeight - top - 16)}px`;
  }
  // A delegated listener also covers pages installed by Astro's client router.
  document.addEventListener("beforetoggle", (event) => {
    if (event instanceof ToggleEvent && event.newState === "open" && event.target instanceof HTMLElement && event.target.hasAttribute("data-tool-help")) {
      positionHelp(event.target);
    }
  }, true);
  window.addEventListener("resize", () => {
    const popover = document.querySelector<HTMLElement>('[data-tool-help]:popover-open');
    if (popover) positionHelp(popover);
  });
  document.addEventListener("scroll", (event) => {
    const popover = document.querySelector<HTMLElement>('[data-tool-help]:popover-open');
    if (popover && event.target instanceof Node && !popover.contains(event.target)) popover.hidePopover();
  }, true);
</script>

<style>
  .tool-help-trigger,
  aside button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
    touch-action: manipulation;
  }
  .tool-help-trigger:hover,
  aside button:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  button:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }
  aside {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 1rem;
    overflow: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-panel);
    background: var(--bg-secondary);
    color: var(--text-primary);
    box-shadow: 0 12px 32px rgb(0 0 0 / 25%);
    opacity: 0;
    transform: translateY(-0.25rem);
    transition: opacity 140ms ease, transform 140ms ease, display 140ms allow-discrete, overlay 140ms allow-discrete;
  }
  aside:popover-open {
    opacity: 1;
    transform: translateY(0);
  }
  @starting-style {
    aside:popover-open {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }
  aside header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  aside h2 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  aside button {
    border-color: transparent;
    background: transparent;
  }
  aside p {
    margin: 0.5rem 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) {
    aside {
      transition: none;
      transform: none;
    }
  }
</style>
