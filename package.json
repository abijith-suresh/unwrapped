{
  "name": "unwrapped",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "version": "0.0.5",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run type-check:scripts && bun run lint && bun run format:check && bun run build && bun run test",
    "og": "bun scripts/generate-og.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.3.5",
    "csso": "^5.0.5",
    "diff": "^9.0.0",
    "html-entities": "^2.6.0",
    "lucide-solid": "^1.48.0",
    "markdown-it": "^15.0.2",
    "papaparse": "^5.7.0",
    "smol-toml": "^1.9.0",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource/manrope": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/csso": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "satori": "^0.33.5",
    "sharp": "^0.35.4",
    "typescript": "6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
