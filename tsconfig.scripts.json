{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*.ts", "./src/*"] },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.d.ts"],
  "exclude": []
}
